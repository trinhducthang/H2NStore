# Sao chép thành .env.local để đổi thông tin hiển thị khi chạy dev (không chứa bí mật).
# Chạy bằng Docker thì đặt các biến SHOP_* tương ứng trong file .env ở thư mục gốc.
# Để trống = dùng mặc định; đặt "-" = ẩn mục đó (VD: VITE_TWITTER_URL=-).
VITE_SHOP_NAME=H2N Store
VITE_SHOP_TAGLINE=Say it with flowers
VITE_SHOP_HOTLINE=0912 345 678
VITE_SHOP_ADDRESS=Hà Nội

VITE_FACEBOOK_URL=https://www.facebook.com/
VITE_TWITTER_URL=https://x.com/
VITE_INSTAGRAM_URL=https://www.instagram.com/

# Nút chat nổi góc phải: số Zalo hoặc link zalo.me/...; tên trang Facebook hoặc link m.me/...
# Để trống: Zalo = hotline, Messenger = lấy từ VITE_FACEBOOK_URL (không có thì mở messenger.com)
VITE_ZALO=
VITE_MESSENGER=
