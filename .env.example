# Sao chép thành .env rồi sửa. KHÔNG commit file .env lên Git.

SPRING_PROFILES_ACTIVE=prod
DB_NAME=flowershop
DB_USER=flowershop
DB_PASSWORD=doi-mat-khau-manh

# Tối thiểu 32 ký tự ngẫu nhiên. Tạo bằng: openssl rand -base64 48
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# Địa chỉ chính thức của web: dùng cho CORS và đường dẫn tuyệt đối trong thẻ SEO (canonical), sitemap.xml, robots.txt
FRONTEND_URL=https://shophoa.example.com
COOKIE_SECURE=true

# ---------- SePay ----------
# my.sepay.vn > Tích hợp Webhooks > Thêm webhook:
#   URL gọi:            https://shophoa.example.com/api/public/payments/sepay/webhook
#   Kiểu chứng thực:    API Key   (dán giá trị SEPAY_WEBHOOK_API_KEY bên dưới)
#   Content type:       application/json
SEPAY_WEBHOOK_API_KEY=thay-bang-api-key-ngau-nhien
# Mã ngân hàng theo qr.sepay.vn (VD: MBBank, Vietcombank, ACB, TPBank, BIDV, VPBank...)
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=0123456789
SEPAY_ACCOUNT_NAME=NGUYEN VAN A
# Để trống nếu ngân hàng không yêu cầu; một số tài khoản VA của SePay cần tiền tố SEVQR
SEPAY_CONTENT_PREFIX=
# Đơn SePay chưa thanh toán sau thời gian này sẽ tự hủy
SEPAY_PAYMENT_TTL=30m

# ---------- Thông báo (tùy chọn) ----------
TG_TOKEN=
TG_CHAT_ID=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@shophoa.example.com

# ---------- Cache (tùy chọn) ----------
CACHE_TYPE=simple
REDIS_ENABLED=false

SWAGGER_ENABLED=false

# ---------- Thông tin hiển thị trên web (build vào frontend) ----------
# Để trống = mặc định; đặt "-" = ẩn (VD: SHOP_TWITTER_URL=-). Đổi xong cần build lại: docker compose up -d --build web
# SHOP_NAME, SHOP_HOTLINE, SHOP_ADDRESS còn được backend dùng cho thẻ SEO và llms.txt (đổi xong: docker compose up -d app)
SHOP_NAME=H2N Store
SHOP_TAGLINE=Say it with flowers
SHOP_HOTLINE=0912 345 678
SHOP_ADDRESS=Hà Nội
SHOP_FACEBOOK_URL=
SHOP_TWITTER_URL=
SHOP_INSTAGRAM_URL=
# Nút chat nổi: số Zalo (hoặc link zalo.me/...), tên trang Facebook cho Messenger (hoặc link m.me/...).
# Để trống: Zalo = SHOP_HOTLINE, Messenger = lấy từ SHOP_FACEBOOK_URL; "-" = ẩn nút
SHOP_ZALO=
SHOP_MESSENGER=
